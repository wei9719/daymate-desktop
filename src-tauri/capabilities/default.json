{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only the local main window can access personal data, AI credentials and settings.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:window:allow-get-all-windows",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "allow-set-tracking",
    "allow-get-today-stats",
    "allow-delete-activity-data",
    "allow-data-location",
    "allow-save-ai-key",
    "allow-get-ai-key-status",
    "allow-delete-ai-key",
    "allow-test-ai-connection",
    "allow-recommend-music-with-ai",
    "allow-list-ai-models",
    "allow-generate-encouragement",
    "allow-get-ai-usage",
    "allow-get-system-integration-status",
    "allow-set-system-autostart",
    "allow-send-test-notification",
    "allow-send-focus-completed-notification",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://audius.co" },
        { "url": "https://audius.co/*" },
        { "url": "https://opengameart.org/*" },
        { "url": "https://github.com/zhangweiguo9719-web/daymate-desktop" },
        { "url": "https://github.com/zhangweiguo9719-web/daymate-desktop/*" }
      ]
    }
  ]
}
